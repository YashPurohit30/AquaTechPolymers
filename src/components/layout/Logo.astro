---
interface Props { class?: string; dark?: boolean }
const { class: cls = 'w-10 h-10', dark = false } = Astro.props;
const stroke = dark ? '#fff' : '#101418';
const accent = dark ? '#FF3742' : '#D51E28';
---
<svg viewBox="0 0 64 64" class={cls} aria-hidden="true">
  <path d="M32 5 C44 23 52 31 52 39 A20 20 0 0 1 12 39 C12 31 20 23 32 5 Z"
        fill="none" stroke={stroke} stroke-width="4" stroke-linejoin="round" />
  <circle cx="32" cy="39" r="11.5" fill="none" stroke={accent} stroke-width="3.5" />
  <circle cx="32" cy="39" r="4.5" fill={accent} />
</svg>
