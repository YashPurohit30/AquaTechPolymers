---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { NAV } from '@/consts';
import Icon from '@/components/ui/Icon.astro';
import logoSrc from '@/assets/images/logo.png';
import distributionSrc from '@/assets/images/hero-distribution-transformer.jpg';
import crepeWrapSrc from '@/assets/images/hero-crepe-paper-wrap.jpg';
import powerSrc from '@/assets/images/hero-power-transformer-substation.jpg';
import windingSrc from '@/assets/images/winding-core.jpg';

const logo = await getImage({ src: logoSrc, width: logoSrc.width, format: 'webp' });

// Same product data + contextual photos as the homepage ProductExplorer
// section — this dropdown is a compact preview of that same content.
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const photoByProduct: Record<string, ImageMetadata> = {
  'pba-series': distributionSrc,
  'crepe-paper-tube-adhesive': crepeWrapSrc,
  'atp-power-transformer-series': powerSrc,
  'cotton-tape': windingSrc,
};
const menuItems = await Promise.all(
  products.map(async (p) => ({
    product: p,
    img: await getImage({ src: photoByProduct[p.slug], width: 480, height: 320, format: 'webp' }),
  }))
);

// Same pattern for the Applications dropdown — reuses the same two photos
// already imported above, keyed by application slug instead of product slug.
const applications = (await getCollection('applications')).sort((a, b) => a.data.order - b.data.order);
const photoByApplication: Record<string, ImageMetadata> = {
  'distribution-transformers': distributionSrc,
  'power-transformers': powerSrc,
};
const appMenuItems = await Promise.all(
  applications.map(async (a) => ({
    app: a,
    img: await getImage({ src: photoByApplication[a.slug], width: 480, height: 320, format: 'webp' }),
  }))
);
---
<header id="top" data-head class="sticky top-0 z-50 border-b border-line">
  <!-- top strip: brand red, logo only -->
  <div class="bg-red">
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8 h-28 flex items-center">
      <a href="/" class="flex items-center shrink-0">
        <img src={logo.src} width={logo.attributes.width} height={logo.attributes.height}
             alt="Aqua Tech Polymers" class="h-24 w-auto" />
      </a>
    </div>
  </div>

  <!-- nav strip: white, kept compact since the red strip above now carries the brand -->
  <div class="bg-white/95 backdrop-blur">
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8 h-14 flex items-center justify-end gap-8">
      <nav class="hidden lg:flex items-center gap-2 text-[17px] font-semibold text-ink/80" aria-label="Main">
        {NAV.map((n) => n.label === 'Products' ? (
          <div class="relative">
            <a href="/products" id="productsTrigger" class="nav-a flex items-center gap-1.5" aria-expanded="false"
               aria-controls="productsMenu">
              Products
              <svg id="productsChevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" class="transition-transform" aria-hidden="true">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </a>
          </div>
        ) : n.label === 'Applications' ? (
          <div class="relative">
            <a href="/applications" id="applicationsTrigger" class="nav-a flex items-center gap-1.5" aria-expanded="false"
               aria-controls="applicationsMenu">
              Applications
              <svg id="applicationsChevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5" class="transition-transform" aria-hidden="true">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </a>
          </div>
        ) : (
          <a href={n.href} class="nav-a whitespace-nowrap">{n.label}</a>
        ))}
      </nav>

      <a href="/contact"
         class="hidden lg:inline-flex btn btn-red items-center gap-2 text-white px-6 py-3 rounded-md font-medium text-sm whitespace-nowrap">
        Request a sample
        <Icon name="arrow" size={14} />
      </a>

      <button id="mBtn" class="lg:hidden w-11 h-11 rounded-md border border-line flex items-center justify-center"
              aria-label="Toggle menu" aria-expanded="false" aria-controls="mMenu">
        <Icon name="menu" size={22} class="block" />
        <Icon name="close" size={22} class="hidden" />
      </button>
    </div>
  </div>

  <!-- Products mega-menu: click "Products" above to open. Same product data as
       the homepage explorer, rendered here too (not hidden behind JS-only
       mount) so it isn't invisible to crawlers. -->
  <div id="productsMenu" class="hidden absolute left-0 right-0 top-full bg-white border border-line shadow-2xl">
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8 pt-6">
      <div class="flex items-center justify-between pb-5 border-b border-line">
        <p class="font-mono text-xs text-steel">OUR PRODUCTS</p>
        <a href="/products" class="font-mono text-xs text-red inline-flex items-center gap-2
                                   hover:gap-3 transition-all">
          View all products
          <Icon name="arrow" size={13} />
        </a>
      </div>
    </div>
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8 py-8 grid grid-cols-12 gap-10 items-center">
      <div class="col-span-4 border border-line rounded-2xl overflow-hidden divide-y divide-line" role="tablist">
        {menuItems.map(({ product: p }, i) => (
          <button class={`nav-tab w-full text-left px-5 py-4 flex items-center justify-between gap-3${i === 0 ? ' active' : ''}`}
                  data-nt={i} role="tab" aria-selected={i === 0} aria-controls={`nav-panel-${i}`}>
            <span>
              <span class="block font-mono text-[10px] text-red mb-0.5">SERIES {p.data.series}</span>
              <span class="block font-medium text-sm text-ink">{p.data.title.split(' for ')[0].split(' — ')[0].split(' (')[0]}</span>
            </span>
            <span class="nav-tab-arrow shrink-0 w-7 h-7 rounded-full border border-line flex items-center
                         justify-center text-ink/40">
              <Icon name="arrow" size={12} />
            </span>
          </button>
        ))}
      </div>

      <div class="col-span-8">
        {menuItems.map(({ product: p, img }, i) => (
          <div class={`nav-panel${i === 0 ? ' show' : ''} grid-cols-12 gap-8 items-center`}
               id={`nav-panel-${i}`} role="tabpanel">
            <div class="col-span-6">
              <div class="photo rounded-lg" style={`--img:url('${img.src}');height:150px`}></div>
            </div>
            <div class="col-span-6">
              <p class="font-mono text-[10px] text-red mb-2">SERIES {p.data.series}</p>
              <h3 class="text-lg font-medium leading-tight">{p.data.title}</h3>
              <p class="mt-2 text-ink/60 text-sm leading-relaxed line-clamp-3">{p.data.summary}</p>
              <a href={`/products/${p.slug}`}
                 class="mt-3 inline-flex items-center gap-2 text-red text-sm font-medium hover:gap-3 transition-all">
                Full specification
                <Icon name="arrow" size={13} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Applications mega-menu: same pattern as Products above. -->
  <div id="applicationsMenu" class="hidden absolute left-0 right-0 top-full bg-white border border-line shadow-2xl">
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8 pt-6">
      <div class="flex items-center justify-between pb-5 border-b border-line">
        <p class="font-mono text-xs text-steel">WHERE IT GOES</p>
        <a href="/applications" class="font-mono text-xs text-red inline-flex items-center gap-2
                                       hover:gap-3 transition-all">
          View all applications
          <Icon name="arrow" size={13} />
        </a>
      </div>
    </div>
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8 py-8 grid grid-cols-12 gap-10 items-center">
      <div class="col-span-4 border border-line rounded-2xl overflow-hidden divide-y divide-line" role="tablist">
        {appMenuItems.map(({ app: a }, i) => (
          <button class={`nav-tab w-full text-left px-5 py-4 flex items-center justify-between gap-3${i === 0 ? ' active' : ''}`}
                  data-nt={i} role="tab" aria-selected={i === 0} aria-controls={`app-nav-panel-${i}`}>
            <span class="block font-medium text-sm text-ink">
              {a.data.title.replace(/^Compounds for /, '')}
            </span>
            <span class="nav-tab-arrow shrink-0 w-7 h-7 rounded-full border border-line flex items-center
                         justify-center text-ink/40">
              <Icon name="arrow" size={12} />
            </span>
          </button>
        ))}
      </div>

      <div class="col-span-8">
        {appMenuItems.map(({ app: a, img }, i) => (
          <div class={`nav-panel${i === 0 ? ' show' : ''} grid-cols-12 gap-8 items-center`}
               id={`app-nav-panel-${i}`} role="tabpanel">
            <div class="col-span-6">
              <div class="photo rounded-lg" style={`--img:url('${img.src}');height:150px`}></div>
            </div>
            <div class="col-span-6">
              <h3 class="text-lg font-medium leading-tight">{a.data.title}</h3>
              <p class="mt-2 text-ink/60 text-sm leading-relaxed line-clamp-3">{a.data.summary}</p>
              <a href={`/applications/${a.slug}`}
                 class="mt-3 inline-flex items-center gap-2 text-red text-sm font-medium hover:gap-3 transition-all">
                View application
                <Icon name="arrow" size={13} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div id="mMenu" class="lg:hidden hidden border-t border-line bg-white">
    <nav class="max-w-[1240px] mx-auto px-5 py-3 flex flex-col divide-y divide-line" aria-label="Mobile">
      {NAV.map((n) => <a href={n.href} class="py-3.5 text-[17px] font-semibold">{n.label}</a>)}
      <a href="/contact" class="mt-3 mb-2 btn-red text-white text-center py-3.5 rounded-md font-medium">
        Request a sample
      </a>
    </nav>
  </div>
</header>

<script>
  // Header renders fresh on every page under View Transitions, so all of
  // this re-binds on `astro:page-load`. The two document-level listeners
  // (outside-click, Escape) are the exception — document persists across
  // navigations, so they're bound only once and look up the current
  // mega-menu elements fresh each time they fire, rather than closing over
  // a specific (possibly stale) pMenu/pTrigger reference.
  let headerDocListenersBound = false;

  function headerSetup() {
    const btn = document.getElementById('mBtn');
    const menu = document.getElementById('mMenu');
    if (btn && menu) {
      const [open, close] = btn.querySelectorAll('svg');
      const set = (isOpen: boolean) => {
        menu.classList.toggle('hidden', !isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
        open.classList.toggle('hidden', isOpen);
        close.classList.toggle('hidden', !isOpen);
      };
      btn.addEventListener('click', () => set(menu.classList.contains('hidden')));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    }

    /* Mega-menus (Products, Applications): same wiring for both, generalised
       so the logic isn't duplicated. Opens on hover (mouse), still supports
       click/keyboard for touch and accessibility. A short close delay stops
       it snapping shut while the pointer crosses the gap between the
       trigger and the panel. Opening one closes the other. */
    type MegaMenuIds = { trigger: string; menu: string; chevron: string };
    const megaMenus: MegaMenuIds[] = [
      { trigger: 'productsTrigger', menu: 'productsMenu', chevron: 'productsChevron' },
      { trigger: 'applicationsTrigger', menu: 'applicationsMenu', chevron: 'applicationsChevron' },
    ];
    const setters: Array<(isOpen: boolean) => void> = [];

    megaMenus.forEach(({ trigger: triggerId, menu: menuId, chevron: chevronId }, idx) => {
      const trigger = document.getElementById(triggerId);
      const menu = document.getElementById(menuId);
      const chevron = document.getElementById(chevronId);
      if (!trigger || !menu) { setters.push(() => {}); return; }

      let closeTimer: ReturnType<typeof setTimeout> | undefined;
      const setMenu = (isOpen: boolean) => {
        clearTimeout(closeTimer);
        menu.classList.toggle('hidden', !isOpen);
        trigger.setAttribute('aria-expanded', String(isOpen));
        chevron?.classList.toggle('rotate-180', isOpen);
        if (isOpen) setters.forEach((s, i) => { if (i !== idx) s(false); });
      };
      setters.push(setMenu);
      const scheduleClose = () => { closeTimer = setTimeout(() => setMenu(false), 350); };

      trigger.addEventListener('mouseenter', () => setMenu(true));
      menu.addEventListener('mouseenter', () => setMenu(true));
      trigger.addEventListener('mouseleave', scheduleClose);
      menu.addEventListener('mouseleave', scheduleClose);

      // trigger is now a real link (was a toggle-only button — clicking it
      // did nothing but open the preview, never actually navigated to the
      // page). Hover/focus still show the preview; a click just follows
      // the link natively, same as any other nav item.
      trigger.addEventListener('focus', () => setMenu(true));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      /* left-list tab switching inside this mega-menu — hover switches too */
      const navTabs = [...menu.querySelectorAll<HTMLElement>('.nav-tab')];
      const navPanels = [...menu.querySelectorAll<HTMLElement>('.nav-panel')];
      const showNavTab = (t: HTMLElement) => {
        const i = Number(t.dataset.nt);
        navTabs.forEach((x) => { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
        navPanels.forEach((p) => p.classList.remove('show'));
        t.classList.add('active');
        t.setAttribute('aria-selected', 'true');
        navPanels[i]?.classList.add('show');
      };
      navTabs.forEach((t) => {
        t.addEventListener('click', () => showNavTab(t));
        t.addEventListener('mouseenter', () => showNavTab(t));
      });
    });

    if (!headerDocListenersBound) {
      headerDocListenersBound = true;
      const closeAll = () => {
        megaMenus.forEach(({ trigger: triggerId, menu: menuId, chevron: chevronId }) => {
          document.getElementById(menuId)?.classList.add('hidden');
          document.getElementById(triggerId)?.setAttribute('aria-expanded', 'false');
          document.getElementById(chevronId)?.classList.remove('rotate-180');
        });
      };
      document.addEventListener('click', (e) => {
        const insideAny = megaMenus.some(({ trigger: triggerId, menu: menuId }) => {
          const menuEl = document.getElementById(menuId);
          const triggerEl = document.getElementById(triggerId);
          return (menuEl && menuEl.contains(e.target as Node)) || e.target === triggerEl;
        });
        if (!insideAny) closeAll();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
    }
  }

  document.addEventListener('astro:page-load', headerSetup);
</script>
