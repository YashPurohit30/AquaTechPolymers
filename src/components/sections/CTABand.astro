---
import Icon from '@/components/ui/Icon.astro';
interface Props { title?: string; body?: string; ctaLabel?: string; ctaHref?: string }
const {
  title = "Send us your spec. We'll send back a grade.",
  body = "Thermal class, cure method, substrate and volume — that's all we need to shortlist something and get a sample moving.",
  ctaLabel = 'Request a sample',
  ctaHref = '/contact',
} = Astro.props;
---
<section class="gradient-shift relative overflow-hidden" style="background-image:linear-gradient(120deg,#D51E28,#8E0810)">
  <div class="absolute inset-0"
       style="background:radial-gradient(120% 140% at 80% -30%, rgba(255,255,255,.2), transparent 60%)"></div>
  <div class="relative max-w-[1240px] mx-auto px-5 sm:px-8 py-20 flex flex-col lg:flex-row
              items-center justify-between gap-10 rv">
    <div class="text-white max-w-2xl">
      <h2 class="leading-[1.08] font-light" style="font-size:clamp(1.9rem,3vw,2.7rem)">{title}</h2>
      <p class="mt-3 text-white/85 text-lg font-light">{body}</p>
    </div>
    <a href={ctaHref} class="btn inline-flex items-center gap-2 bg-white text-red px-8 py-4
                             rounded-md font-medium hover:bg-ink hover:text-white whitespace-nowrap">
      {ctaLabel}
      <Icon name="arrow" />
    </a>
  </div>
</section>
