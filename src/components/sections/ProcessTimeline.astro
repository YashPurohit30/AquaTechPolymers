---
const steps = [
  { n: '01', title: 'Tell us the process',   body: 'Thermal class, cure method, substrate and volumes. That\u2019s usually enough for us to shortlist a grade.' },
  { n: '02', title: 'Sample in ~72 hours',   body: 'We despatch a trial quantity with the data sheet and safety sheet so you can run it on your own line.' },
  { n: '03', title: 'Qualify with support',  body: 'If results need tuning, we adjust the formulation rather than asking you to change your process.' },
  { n: '04', title: 'Supply to schedule',    body: 'Locked specification, COA with every lot, retained samples, and despatch planned around your production.' },
];
---
<section id="process" class="py-24 lg:py-32">
  <div class="max-w-[1240px] mx-auto px-5 sm:px-8">
    <div class="max-w-2xl rv">
      <p class="kicker-rule text-red mb-5">How we work</p>
      <h2 class="split leading-[1.08] font-light" style="font-size:clamp(2rem,3.6vw,3rem)">
        From first enquiry to repeat supply
      </h2>
      <p class="mt-5 text-ink/60 text-lg font-light">
        Switching a bonded-in material is a risk. We've built the process to take that risk off your line.
      </p>
    </div>

    <div class="mt-16 track grid md:grid-cols-4 gap-10 md:gap-6 pl-16 md:pl-0" id="track">
      <div class="track-fill" id="fill"></div>
      {steps.map((s) => (
        <div class="node">
          <div class="dot-n font-mono text-sm absolute -left-16 top-0 md:static md:mb-6">{s.n}</div>
          <h3 class="text-lg font-medium">{s.title}</h3>
          <p class="text-sm text-ink/60 mt-2 leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // GSAP is imported here only — ProcessTimeline is the single component
  // that needs scrub-linked scroll animation, so it's the only page section
  // that pays for it. Never import gsap from a shared/global script.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const track = document.getElementById('track');
  const fill = document.getElementById('fill');
  const REDUCE = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  const activateNodes = () => {
    document.querySelectorAll<HTMLElement>('.node').forEach((n, i) =>
      setTimeout(() => n.classList.add('on'), 250 + i * 280));
  };

  if (track && fill) {
    const vertical = window.matchMedia('(max-width:767px)').matches;

    if (REDUCE) {
      // original on/off fallback: fill snaps to 100% once the track is in view
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          fill.classList.add('snap');
          if (vertical) fill.style.height = '100%'; else fill.style.width = '100%';
          activateNodes();
          io.unobserve(e.target);
        });
      }, { threshold: 0.35 });
      io.observe(track);
    } else {
      // scrub:true ties the fill's width/height to scroll position exactly,
      // instead of jumping to 100% on first view.
      gsap.registerPlugin(ScrollTrigger);
      gsap.to(fill, {
        [vertical ? 'height' : 'width']: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: track,
          start: 'top 80%',
          end: 'bottom 60%',
          scrub: true,
        },
      });
      ScrollTrigger.create({
        trigger: track,
        start: 'top 80%',
        once: true,
        onEnter: activateNodes,
      });
    }
  }
</script>
