---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import SpecTable from '@/components/ui/SpecTable.astro';
import Icon from '@/components/ui/Icon.astro';
import crepeWrapSrc from '@/assets/images/hero-crepe-paper-wrap.jpg';
import powerSrc from '@/assets/images/hero-power-transformer-substation.jpg';
import pressBoardSrc from '@/assets/images/press-board.jpg';
import kraftPaperSrc from '@/assets/images/kraft-paper.jpg';

// GEO-CRITICAL: every panel is rendered into the HTML at build time and
// toggled with CSS. Never mount panels on click — that hides four fifths
// of the product content from AI crawlers.
//
// Reused on both the homepage (with its own heading + "View all products"
// link) and the dedicated /products page (heading suppressed — that page
// already has its own hero band, and a self-referential "view all" link
// makes no sense once you're already there).
interface Props { showHeader?: boolean }
const { showHeader = true } = Astro.props;

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);

// Photos are contextual (what the product goes into / how it's used), not
// product-shot photography — no photos of the adhesive itself exist yet.
const photoByProduct: Record<string, ImageMetadata> = {
  'press-board-adhesive': pressBoardSrc,
  'power-transformer-adhesive': powerSrc,
  'kraft-paper-adhesive': kraftPaperSrc,
  'crepe-paper-tube-adhesive': crepeWrapSrc,
};
const panels = await Promise.all(
  products.map(async (p) => ({
    product: p,
    img: await getImage({ src: photoByProduct[p.slug], width: 720, height: 480, format: 'webp' }),
  }))
);
---
<section id="products" class="py-24 lg:py-32 bg-bone border-y border-line">
  <div class="max-w-[1240px] mx-auto px-5 sm:px-8">
    {showHeader && (
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 rv">
        <div class="max-w-xl">
          <p class="kicker-rule text-red mb-5">The range</p>
          <h2 class="split leading-[1.08] font-light" style="font-size:clamp(2rem,3.6vw,3rem)">
            Pick a category to see what's inside it
          </h2>
        </div>
        <a href="/products" class="font-mono text-sm text-red inline-flex items-center gap-2
                                   hover:gap-3 transition-all whitespace-nowrap">
          View all products
          <Icon name="arrow" />
        </a>
      </div>
    )}

    <div class={`grid lg:grid-cols-12 gap-6 lg:gap-8 items-start rv ${showHeader ? 'mt-12' : ''}`}>
      <!-- left: vertical product list -->
      <div class="lg:col-span-4 bg-white border border-line rounded-2xl overflow-hidden divide-y divide-line"
           role="tablist">
        {products.map((p, i) => (
          <button class={`tab w-full text-left px-6 py-5 flex items-center justify-between gap-4${i === 0 ? ' active' : ''}`}
                  data-t={i} role="tab" aria-selected={i === 0} aria-controls={`panel-${i}`}>
            <span class="block font-medium text-ink">{p.data.title.split(' for ')[0].split(' — ')[0].split(' (')[0]}</span>
            <span class="tab-arrow shrink-0 w-8 h-8 rounded-full border border-line flex items-center
                         justify-center text-ink/40">
              <Icon name="arrow" size={14} />
            </span>
          </button>
        ))}
      </div>

      <!-- right: active panel, photo + description + specs -->
      <div class="lg:col-span-8">
        {panels.map(({ product: p, img }, i) => (
          <div class={`panel${i === 0 ? ' show' : ''} lg:grid-cols-12 gap-8 items-start`}
               id={`panel-${i}`} role="tabpanel">
            <div class="lg:col-span-6">
              <div class="photo rounded-xl" style={`--img:url('${img.src}');height:320px`}></div>
            </div>
            <div class="lg:col-span-6 mt-6 lg:mt-0">
              <h3 class="text-2xl font-light leading-tight">{p.data.title}</h3>
              <div class="mt-3 w-10 h-0.5 bg-red"></div>
              <p class="mt-5 text-ink/65 leading-relaxed text-[15px]">{p.data.summary}</p>
              <a href={`/products/${p.slug}`}
                 class="mt-6 inline-flex items-center gap-2 text-red font-medium hover:gap-3 transition-all">
                Full specification
                <Icon name="arrow" />
              </a>
            </div>
            <div class="lg:col-span-12 mt-8">
              <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-ink/75 text-sm">
                {p.data.features.map((f) => (
                  <li class="flex gap-3"><span class="text-red">▹</span>{f}</li>
                ))}
              </ul>
              <div class="mt-8">
                <SpecTable specs={p.data.specs} grade={p.data.series}
                           caption={`Typical properties for ${p.data.title}`} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Used on both "/" and "/products" — rebuilds fresh on each View
  // Transitions landing on either page, so this re-runs on `astro:page-load`.
  // No document-level listeners here, so no cross-navigation guarding
  // needed — every binding targets a .tab element freshly created per load.
  function explorerSetup() {
    const tabs = [...document.querySelectorAll<HTMLElement>('.tab')];
    const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
    const showTab = (t: HTMLElement) => {
      const i = Number(t.dataset.t);
      tabs.forEach((x) => { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
      panels.forEach((p) => p.classList.remove('show'));
      t.classList.add('active');
      t.setAttribute('aria-selected', 'true');
      panels[i]?.classList.add('show');
    };
    const FINE = window.matchMedia('(pointer:fine)').matches;
    tabs.forEach((t) => {
      t.addEventListener('click', () => showTab(t));
      // hover switches too, but only for mouse/trackpad — touch devices rely on tap
      if (FINE) t.addEventListener('mouseenter', () => showTab(t));
    });
  }

  document.addEventListener('astro:page-load', explorerSetup);
</script>
