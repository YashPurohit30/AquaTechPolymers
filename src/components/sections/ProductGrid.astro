---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import pressBoardSrc from '@/assets/images/press-board.jpg';
import powerSrc from '@/assets/images/hero-power-transformer-substation.jpg';
import kraftPaperSrc from '@/assets/images/kraft-paper.jpg';
import crepeWrapSrc from '@/assets/images/hero-crepe-paper-wrap.jpg';
import windingCoreSrc from '@/assets/images/winding-core.jpg';

// Card style requested by client: same look as the header's Applications
// dropdown panel — white card, photo strip on top, code/title/description
// below in dark text — laid out as a 3-per-row grid on the /products page.
// GEO-CRITICAL: plain server-rendered links/cards, no JS mounting.
const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);

const photoByProduct: Record<string, ImageMetadata> = {
  'press-board-adhesive': pressBoardSrc,
  'power-transformer-adhesive': powerSrc,
  'kraft-paper-adhesive': kraftPaperSrc,
  'crepe-paper-tube-adhesive': crepeWrapSrc,
  'cotton-tape': windingCoreSrc,
};

const cards = await Promise.all(
  products.map(async (p) => ({
    product: p,
    img: await getImage({ src: photoByProduct[p.slug], width: 640, height: 480, format: 'webp' }),
  }))
);
---
<section class="pt-16 lg:pt-20 pb-24 lg:pb-32 bg-bone border-b border-line">
  <div class="max-w-[1240px] mx-auto px-5 sm:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 rv">
      <div>
        <p class="kicker-rule text-red mb-5">Products by category</p>
        <h1 class="leading-[1.08] font-light" style="font-size:clamp(2rem,3.6vw,3rem)">
          The full adhesive range
        </h1>
      </div>
      <a href="/contact" class="font-mono text-sm text-red inline-flex items-center gap-2
                                hover:gap-3 transition-all whitespace-nowrap">
        Request full catalogue
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6 rv">
      {cards.map(({ product: p, img }) => (
        <a href={`/products/${p.slug}`}
           class="lift group bg-white border border-line rounded-2xl overflow-hidden flex flex-col">
          <div class="photo" style={`--img:url('${img.src}');height:190px`}></div>
          <div class="p-6 flex-1 flex flex-col">
            <span class="font-mono text-xs tracking-wider text-red">{p.data.series}</span>
            <h3 class="mt-1 text-lg font-medium text-ink leading-snug">{p.data.title}</h3>
            <p class="mt-2 text-sm text-ink/60 leading-relaxed line-clamp-2 flex-1">{p.data.summary}</p>
            <span class="mt-4 font-mono text-xs text-red inline-flex items-center gap-2
                         group-hover:gap-3 transition-all">
              Full specification
              <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
