---
import { getImage } from 'astro:assets';
import distributionSrc from '@/assets/images/hero-distribution-transformer.jpg';
import powerSrc from '@/assets/images/hero-power-transformer-substation.jpg';
import pressBoardSrc from '@/assets/images/press-board.jpg';
import laminatedBoardSrc from '@/assets/images/laminated-board.jpg';
import kraftPaperSrc from '@/assets/images/kraft-paper.jpg';
import spacersSrc from '@/assets/images/spacers.png';
import crepeTubeSrc from '@/assets/images/crepe-paper-tube-core.jpg';

const items = [
  {
    slug: 'distribution-transformers', title: 'Distribution transformers', src: distributionSrc,
    body: 'PBA series bonding adhesive (PBA 90R, PBA 93 MV, PBA 96MHV) for core-to-coil and structural bonding, and CPT crepe paper tube adhesive for insulation components — both available with customised characteristics based on your process.',
  },
  {
    slug: 'power-transformers', title: 'Power transformers', src: powerSrc,
    body: 'The ATP series (ATP-3900B, ATP-120) for bonding and manufacturing 8–10 foot insulation cylinders, and CPT crepe paper tube adhesive — supplied to leading Indian power transformer manufacturers under annual supply contracts, as a cost-effective alternative to imported adhesives.',
  },
];
const equipment = await Promise.all(
  items.map(async (i) => ({ ...i, img: await getImage({ src: i.src, width: 640, height: 320, format: 'webp' }) }))
);

// Material/component categories with client photography.
const withPhoto = await Promise.all(
  [
    { label: 'Press Board', src: pressBoardSrc },
    { label: 'Laminated Board', src: laminatedBoardSrc },
    { label: 'Insulation Kraft Paper', src: kraftPaperSrc },
    { label: 'Spacers', src: spacersSrc },
    { label: 'Crepe Paper Tubes', src: crepeTubeSrc },
  ].map(async (i) => ({ label: i.label, img: await getImage({ src: i.src, width: 480, format: 'webp' }) }))
);

// Everything else in the client's supplied-for list, no photo yet.
const alsoSupplied = ['Pre-Compressed Board', 'Press Board Components', 'Dovetail Strips', 'Electrical Insulation Components'];
---
<section id="applications" class="grain glow-zone py-24 lg:py-32 bg-ink text-white relative overflow-hidden">
  <div class="cursor-glow"></div>
  <div class="absolute right-0 top-0 w-[420px] h-[420px] bg-red/12 blur-[130px] rounded-full"></div>
  <div class="relative max-w-[1240px] mx-auto px-5 sm:px-8 grid lg:grid-cols-12 gap-14">
    <div class="lg:col-span-4 rv">
      <p class="kicker-rule text-red-2 mb-5">Where it goes</p>
      <h2 class="split leading-[1.08] font-light" style="font-size:clamp(2rem,3.4vw,2.8rem)">
        Equipment our compounds are built into
      </h2>
      <p class="mt-5 text-white/55 font-light">Open any application to see which series applies.</p>
      <a href="/applications" class="mt-6 font-mono text-sm text-red-2 inline-flex items-center gap-2
                                     hover:gap-3 transition-all">
        Browse applications
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="lg:col-span-8">
      <div class="grid sm:grid-cols-2 gap-4">
        {equipment.map((i) => (
          <a href={`/applications/${i.slug}`}
             class="lift rounded-xl overflow-hidden border border-white/12 block rv">
            <div class="photo" style={`--img:url('${i.img.src}')`}></div>
            <div class="p-6 bg-ink-2">
              <h3 class="text-lg font-medium">{i.title}</h3>
              <p class="text-white/60 text-sm leading-relaxed mt-2.5">{i.body}</p>
            </div>
          </a>
        ))}
      </div>

      <p class="font-mono text-xs text-red-2 mt-10 mb-4">ALSO SUPPLIED FOR</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {withPhoto.map((i) => (
          <div class="rounded-lg overflow-hidden border border-white/12 rv">
            <img src={i.img.src} width={i.img.attributes.width} height={i.img.attributes.height}
                 alt={i.label} loading="lazy" class="w-full h-20 object-cover" />
            <p class="text-xs text-white/70 px-2.5 py-2 leading-snug">{i.label}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-3 mt-3">
        {alsoSupplied.map((item) => (
          <span class="border border-white/15 rounded-full px-5 py-2.5 text-sm text-white/70">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
