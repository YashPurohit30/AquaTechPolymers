---
// No customer logos yet (flagged separately — needs client permission to
// name/show customers). Ticker shows real facts instead: product series
// and positioning already established elsewhere on the site, not invented.
const items = [
  'PBA SERIES — DISTRIBUTION TRANSFORMERS',
  'CPT — CREPE PAPER TUBE ADHESIVE',
  'ATP SERIES — POWER TRANSFORMERS',
  'COTTON TAPE',
  'INDIAN ALTERNATIVE TO IMPORTED ADHESIVES',
  'ANNUAL SUPPLY CONTRACTS',
  'MANUFACTURED IN INDIA SINCE 2004',
];
---
<div class="marquee border-y border-line bg-bone overflow-hidden">
  <div class="marquee-track">
    {[...items, ...items].map((item) => (
      <span class="font-mono text-xs tracking-wider text-ink/50 px-8 py-4 whitespace-nowrap">
        {item}
        <span class="text-red ml-8">◆</span>
      </span>
    ))}
  </div>
</div>
