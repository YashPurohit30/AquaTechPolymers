---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import EnquiryForm from '@/components/forms/EnquiryForm.astro';
---
<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <section class="bg-ink text-white min-h-[60vh] flex items-center">
    <div class="max-w-[1240px] mx-auto px-5 sm:px-8">
      <p class="font-mono text-red-2 text-sm mb-5">404</p>
      <h1 class="leading-[1.05] font-light" style="font-size:clamp(2rem,4vw,3rem)">
        That page doesn't exist.
      </h1>
      <div class="mt-9 flex gap-3">
        <a href="/" class="btn btn-red inline-flex items-center gap-2 text-white px-8 py-4 rounded-md font-medium">Home</a>
        <a href="/products" class="btn inline-flex items-center gap-2 border border-white/25 px-8 py-4 rounded-md font-medium">Products</a>
      </div>
    </div>
  </section>
  <Footer slot="footer"><EnquiryForm slot="form" /></Footer>
</BaseLayout>
