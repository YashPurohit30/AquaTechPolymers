---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import EnquiryForm from '@/components/forms/EnquiryForm.astro';
import ProductGrid from '@/components/sections/ProductGrid.astro';
import CTABand from '@/components/sections/CTABand.astro';
import { breadcrumbSchema } from '@/lib/schema';

const schema = [breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products' },
])];
---
<BaseLayout
  title="Products — Press Board, Power Transformer, Kraft Paper & Crepe Paper Tube Adhesives"
  description="Press board, power transformer, kraft paper and crepe paper tube adhesives for transformer and electrical insulation manufacturing."
  {schema}
>
  <ProductGrid />

  <CTABand />
  <Footer slot="footer"><EnquiryForm slot="form" /></Footer>
</BaseLayout>
